{% extends 'base.twig' %}

{% block content %}
    <article class="noticia_detalle">
        <h2 class="noticia_titulo">Entrar</h2>
        {% include 'partials/errores.twig' ignore missing %}
        <form class="form_admin" method="post">
            <label>Usuario o email
                <input name="usuario" value="{{ datos.usuario }}" />
            </label>
            <label>Contraseña
                <input type="password" name="password" />
            </label>
            <button type="submit">Entrar</button>
        </form>
        <p>¿No tienes cuenta? <a href="registro.php">Regístrate</a>.</p>
    </article>
{% endblock %}
