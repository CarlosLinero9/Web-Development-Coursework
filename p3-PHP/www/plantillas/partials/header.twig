<header>
    <img class="cabecera_logo" src="img/logo.png" alt="Escudo Ayuntamiento" />

    <h1 class="cabecera_titulo">{{ site.title }}</h1>

    {% if print_view is not defined or not print_view %}
        <nav class="cabecera_enlaces">
            <ul>
                {% for link in site.header_links %}
                    <li><a href="{{ link.url }}" target="_blank" rel="noopener">{{ link.label }}</a></li>
                {% endfor %}
            </ul>
        </nav>
    {% endif %}
</header>
