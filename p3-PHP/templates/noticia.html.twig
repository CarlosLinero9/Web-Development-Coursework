{% extends 'base.html.twig' %}

{% block content %}
    <article class="noticia_detalle">
        <header class="noticia_cabecera">
            <h2 class="noticia_titulo">{{ noticia.titulo }}</h2>

            <nav class="noticia_redes" aria-label="Redes sociales y acciones">
                <ul class="lista_redes">
                    {% for social in site.social_links %}
                        <li>
                            <a href="{{ social.url }}" aria-label="{{ social.label }}">
                                <img src="{{ base_url }}/{{ social.icon }}" alt="{{ social.label }}" />
                            </a>
                        </li>
                    {% endfor %}
                    <li>
                        <a href="{{ base_url }}/noticia/{{ noticia.id }}/imprimir" aria-label="Imprimir noticia">
                            <img src="{{ base_url }}/assets/img/imprimir.png" alt="Imprimir noticia" />
                        </a>
                    </li>
                </ul>
            </nav>
        </header>

        <section class="noticia_info">
            <p><strong>Fecha:</strong> {{ noticia.fecha_publicacion|date('d/m/Y') }}</p>
            <p><strong>Tipo:</strong> {{ noticia.tipo }}</p>
            <p><strong>Concejalía:</strong> {{ noticia.concejalia }}</p>
            <p><strong>Responsables:</strong> {{ noticia.personas_responsables }}</p>
            <p><strong>Lugar:</strong> {{ noticia.lugar }}</p>
        </section>

        <section class="noticia_texto">
            {% for parrafo in descripcion_parrafos %}
                <p>{{ parrafo }}</p>
            {% endfor %}
        </section>

        <section class="noticia_imagenes">
            {% for imagen in imagenes %}
                <div class="bloque_imagen">
                    <img src="{{ base_url }}/{{ imagen.ruta }}" alt="Imagen {{ loop.index }} de {{ noticia.titulo }}" />
                    <p class="pie_imagen">{{ imagen.pie }}</p>
                </div>
            {% endfor %}
        </section>
    </article>

    <div id="trigger"></div>

    <div
        id="panel"
        data-open-panel="{{ open_panel ? '1' : '0' }}"
        data-open-form="{{ open_form ? '1' : '0' }}"
        data-modal-title="{{ modal_title|default('')|e('html_attr') }}"
        data-modal-message="{{ modal_message|default('')|e('html_attr') }}"
    >
        <button id="cerrar" type="button">X</button>

        <h3>Comentarios (<span id="contador">{{ comentarios|length }}</span>)</h3>

        <button id="nuevo" type="button">Nuevo comentario</button>

        <form id="formulario" method="post" action="{{ base_url }}/noticia/{{ noticia.id }}" {% if not open_form %}style="display:none;"{% endif %}>
            <input id="nombre" name="nombre" value="{{ form_data.nombre }}" placeholder="Nombre" maxlength="120" />
            <input id="email" name="email" value="{{ form_data.email }}" placeholder="Email" maxlength="180" />
            <textarea id="texto" name="texto" placeholder="Comentario" data-localidades='{{ localidades_json|e('html_attr') }}' maxlength="1200">{{ form_data.texto }}</textarea>

            <div class="botones-formulario">
                <button id="enviar" type="submit">Enviar</button>
                <button id="cancelar" type="button">Cancelar</button>
            </div>
        </form>

        <div id="lista">
            {% for comentario in comentarios %}
                <div>
                    <div class="comentario-cabecera">
                        <strong>{{ comentario.nombre }}</strong>
                        <strong>{{ comentario.fecha_comentario|date('d/m/Y H:i') }}</strong>
                    </div>
                    <p class="comentario-texto">{{ comentario.texto }}</p>
                </div>
            {% else %}
                <div>
                    <p class="comentario-texto">Todavía no hay comentarios para esta noticia.</p>
                </div>
            {% endfor %}
        </div>
    </div>

    <div id="modal-error" class="modal-oculto">
        <div class="modal-fondo"></div>
        <div class="modal-caja">
            <h4 id="modal-titulo">Aviso</h4>
            <p id="modal-mensaje"></p>
            <button id="cerrar-modal" type="button">Cerrar</button>
        </div>
    </div>
{% endblock %}

{% block scripts %}
    <script src="{{ base_url }}/assets/js/noticia.js"></script>
{% endblock %}
